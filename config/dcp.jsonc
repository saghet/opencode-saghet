{
  "$schema": "https://raw.githubusercontent.com/Tarquinen/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": false,
  "debug": false,
  "pruneNotification": "detailed",
  "pruneNotificationType": "chat",
  "compress": {
    "permission": "deny",
    "mode": "range",
    "minContextLimit": 9000,
    "maxContextLimit": 19500,
    "protectUserMessages": true
  },
  "strategies": {
    "deduplication": {
      "enabled": true
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 2
    }
  }
}
